# === API ===
API_TOKEN=your-secret-key-here
API_TITLE=Sistema de Búsqueda de RUC
API_VERSION=1.0.0
API_DESCRIPTION=API para consulta del padrón SUNAT

# === Web ===
WEB_TITLE=Búsqueda RUC SUNAT
WEB_DESCRIPTION=Sistema de consulta del padrón de contribuyentes

# === CORS ===
CORS_ORIGINS=*

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=100

# === Cache ===
CACHE_SIZE=10000
CACHE_TTL=3600

# === Database ===
DATABASE_URL=data/contribuyentes.db

# === Updater ===
SCRAPER_URL=http://www2.sunat.gob.pe/padron_reducido_ruc.zip

# === Logging ===
LOG_LEVEL=INFO
LOG_DIR=logs
